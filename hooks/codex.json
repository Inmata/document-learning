{
  "description": "文档任务轻量判断、经验检索与逐轮学习回执",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bin/document-learning.mjs\" hook --agent codex",
            "timeout": 10,
            "commandWindows": "node \"$env:PLUGIN_ROOT/bin/document-learning.mjs\" hook --agent codex",
            "additionalContextLimit": 2400
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bin/document-learning.mjs\" hook --agent codex",
            "timeout": 10,
            "commandWindows": "node \"$env:PLUGIN_ROOT/bin/document-learning.mjs\" hook --agent codex",
            "additionalContextLimit": 2400
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bin/document-learning.mjs\" hook --agent codex",
            "timeout": 10,
            "commandWindows": "node \"$env:PLUGIN_ROOT/bin/document-learning.mjs\" hook --agent codex",
            "additionalContextLimit": 8000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bin/document-learning.mjs\" hook --agent codex",
            "timeout": 10,
            "commandWindows": "node \"$env:PLUGIN_ROOT/bin/document-learning.mjs\" hook --agent codex"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bin/document-learning.mjs\" hook --agent codex",
            "timeout": 10,
            "commandWindows": "node \"$env:PLUGIN_ROOT/bin/document-learning.mjs\" hook --agent codex"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bin/document-learning.mjs\" hook --agent codex",
            "timeout": 10,
            "commandWindows": "node \"$env:PLUGIN_ROOT/bin/document-learning.mjs\" hook --agent codex"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bin/document-learning.mjs\" hook --agent codex",
            "timeout": 3,
            "commandWindows": "node \"$env:PLUGIN_ROOT/bin/document-learning.mjs\" hook --agent codex"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bin/document-learning.mjs\" hook --agent codex",
            "timeout": 3,
            "commandWindows": "node \"$env:PLUGIN_ROOT/bin/document-learning.mjs\" hook --agent codex"
          }
        ]
      }
    ]
  }
}
