{
  "description": "登记会话请求与问答回答，会话开始和结束时后台触发经验整理",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bin/document-learning.mjs\" hook --agent codex",
            "timeout": 10,
            "commandWindows": "node \"$env:PLUGIN_ROOT/bin/document-learning.mjs\" hook --agent codex",
            "additionalContextLimit": 2400
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bin/document-learning.mjs\" hook --agent codex",
            "timeout": 10,
            "commandWindows": "node \"$env:PLUGIN_ROOT/bin/document-learning.mjs\" hook --agent codex",
            "additionalContextLimit": 2400
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bin/document-learning.mjs\" hook --agent codex",
            "timeout": 10,
            "commandWindows": "node \"$env:PLUGIN_ROOT/bin/document-learning.mjs\" hook --agent codex",
            "additionalContextLimit": 8000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bin/document-learning.mjs\" hook --agent codex",
            "timeout": 3,
            "commandWindows": "node \"$env:PLUGIN_ROOT/bin/document-learning.mjs\" hook --agent codex"
          }
        ]
      }
    ]
  }
}
